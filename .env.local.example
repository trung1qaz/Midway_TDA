# --- Gemini (server-side only) ---
GEMINI_API_KEY=
# Leave blank to use the default (gemini-flash-latest, the current Flash alias)
GEMINI_MODEL=

# --- OpenStreetMap services (no keys needed) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
# Nearby-town search used when a candidate point falls outside town limits
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Identify the app and give a contact, per the Nominatim/OSRM usage policies
APP_USER_AGENT=Midway/0.2 (student project; contact: your-email@example.com)

# --- Use fixture responses instead of live services (demo backup / offline) ---
MIDWAY_USE_MOCKS=false

# Open-Meteo (Checkpoint #3): no key required for the free tier
